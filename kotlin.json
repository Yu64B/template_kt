	"Permutations for iterable": {
		"prefix": ["permutations"],
		"body": [
			"// 未完成",
			"\tfun <T> Iterable<T>.permutations(r: Int = count()): List<List<T>> {",
			"\tval result = ArrayList<List<T>>()",
			"\tval n = count()",
			"\tif (r > n || r <= 0) return result",
			"\tval indices = IntArray(n) { it }",
			"\tval cycles = IntArray(r) { n - it }",
			"\tresult.add(indices.take(r).map { elementAt(it) })",
			"\t\twhile (true) {",
			"\t\t\tfor (i in (0 until r).reversed()) {",
			"\t\t\tcycles[i]--",
			"\t\t\tif (cycles[i] == 0) {",
			"\t\t\t\tif (cycles[0] == 0) return result",
			"\t\t\t\tindices[n - 1] = indices[i].also { for (j in i until n - 1) indices[j] = indices[j + 1] }",
			"\t\t\t\tcycles[i] = n - i",
			"\t\t\t}",
			"\t\t\telse {",
			"\t\t\t\tval j = cycles[i]",
			"\t\t\t\tindices[n - j] = indices[i].also { indices[i] = indices[n - j] }",
			"\t\t\t\tresult.add(indices.take(r).map { elementAt(it) })",
			"\t\t\t\tbreak",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"}",
			""
		],
