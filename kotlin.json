			"fun primeFactorize(x: Long): List<Pair<Long, Int>> {",
			"\tval result = mutableListOf<Pair<Long, Int>>()",
			"\tvar remainingValue = x",
			"\tvar primeNumber = 2L",
			"\twhile (primeNumber * primeNumber <= remainingValue) {",
			"\t\tif (remainingValue % primeNumber != 0L) {",
			"\t\t\tprimeNumber++",
			"\t\t\tcontinue",
			"\t\t}",
			"\t\tvar count = 0",
			"\t\twhile (remainingValue % primeNumber == 0L) {",
			"\t\t\tcount++",
			"\t\t\tremainingValue /= primeNumber",
			"\t\t}",
			"\t\tresult.add(Pair(primeNumber, count))",
			"\t\tprimeNumber++",
			"\t}",
			"\tif (remainingValue != 1L) {",
			"\t\tresult.add(Pair(remainingValue, 1))",
			"\t}",
			"\treturn result",
			"}",
			""
		],
		"description": "Prime factorize"
