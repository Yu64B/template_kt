			"\trequire(all { it.size == first().size }) { \"The dimension sizes of all elements must match.\" }",
			"\trequire(k > 0) { \"k must be at least 1.\" }",
			"\tval clusters = Array(size) { random.nextInt(k) }",
			"\tval centroids = List(k) { Array(first().size) { 0.0 } }",
			"\t// 高速化のため変数を使いまわす",
			"\tval elementsCounts = Array(k) { 0 }",
			"\tval centroidsSums = List(k) { Array(first().size) { 0L } }",
			"\tfor (time in 0 until maxTimes) {",
			"\t\t// クラスターの重心の更新",
			"\t\tfor (cluster in 0 until k) {",
			"\t\t\telementsCounts[cluster] = 0",
			"\t\t\tfor (dim in 0 until centroidsSums[cluster].size) {",
			"\t\t\t\tcentroidsSums[cluster][dim] = 0",
			"\t\t\t}",
			"\t\t}",
			"\t\tfor (index in 0 until size) {",
