			"\t\t\telementsCounts[cluster]++",
			"\t\t\tfor (dim in 0 until this[index].size) {",
			"\t\t\t\tcentroidsSums[cluster][dim] += this[index][dim]",
			"\t\t\t}",
			"\t\t}",
			"\t\tfor (cluster in 0 until k) {",
			"\t\t\tif (elementsCounts[cluster] != 0) {",
			"\t\t\t\tfor (dim in 0 until centroids[cluster].size) {",
			"\t\t\t\t\tcentroids[cluster][dim] = centroidsSums[cluster][dim].toDouble() / elementsCounts[cluster]",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t\t// クラスターに所属する要素が0のときは、そのクラスターの重心をランダムな要素の座標に一致させる",
			"\t\t\telse {",
			"\t\t\t\tval randomIndex = random.nextInt(size)",
			"\t\t\t\tfor (dim in 0 until centroids[cluster].size) {",
			"\t\t\t\t\tcentroids[cluster][dim] = this[randomIndex][dim].toDouble()",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t\t// 要素の所属の更新",
			"\t\tvar movedCount = 0",
			"\t\tfor (index in 0 until size) {",
			"\t\t\tvar closestDistance = (this[index] zip centroids[0]).map { Math.abs(it.first - it.second) * Math.abs(it.first - it.second) }.sum()",
			"\t\t\tvar closestCluster = 0",
			"\t\t\tfor (cluster in 0 until k) {",
			"\t\t\t\tval distance = (this[index] zip centroids[cluster]).map { Math.abs(it.first - it.second) * Math.abs(it.first - it.second) }.sum()",
			"\t\t\t\tif (distance < closestDistance) {",
			"\t\t\t\t\tclosestDistance = distance",
			"\t\t\t\t\tclosestCluster = cluster",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t\tif (closestCluster != clusters[index]) {",
			"\t\t\t\tclusters[index] = closestCluster",
			"\t\t\t\tmovedCount++",
			"\t\t\t}",
			"\t\t}",
			"\t\tif (movedCount == 0) {",
			"\t\t\tbreak",
			"\t\t}",
			"\t}",
			"\tval results = List(k) { mutableListOf<List<Long>>() }",
			"\tfor (index in 0 until size) {",
			"\t\tval cluster = clusters[index]",
			"\t\tresults[cluster].add(this[index])",
			"\t}",
			"\treturn results",
			"}",
