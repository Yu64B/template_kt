		"prefix": ["runLengthEncode"],
		"body": [
			"fun <T> Iterable<T>.runLengthEncode(): List<Pair<T, Int>> {",
			"\tval result = ArrayList<Pair<T, Int>>()",
			"\tval iterator = iterator()",
			"\tif (!iterator.hasNext()) return result",
			"\tvar previousElement = iterator.next()",
			"\tvar count = 1",
			"\twhile (iterator.hasNext()) {",
			"\t\tval element = iterator.next()",
			"\t\tif (element == previousElement) count++",
			"\t\telse {",
			"\t\t\tresult.add(Pair(previousElement, count))",
			"\t\t\tpreviousElement = element",
			"\t\t\tcount = 1",
			"\t\t}",
			"\t}",
			"\tresult.add(Pair(previousElement, count))",
			"\treturn result",
			"}",
			""
		],
		"description": "Run length encode for iteralbe"
