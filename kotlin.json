		"prefix": ["UnionFind"],
		"body": [
			"class UnionFind(val n: Int) {",
			"\tval parents = IntArray(n) { -1 } // 親の番号 (-1で初期化)",
			"\tvar groups = n // 集合の個数",
			"\t// 木の根を求める",
			"\tfun findRoot(x: Int): Int {",
			"\t\tif (parents[x] < 0) return x // 根",
			"\t\telse {",
			"\t\t\tparents[x] = findRoot(parents[x]) // 経路圧縮",
			"\t\t\treturn parents[x]",
			"\t\t}",
			"\t}",
			"\t// xとyが同じ集合に属するか否か",
			"\tfun same(x: Int, y: Int): Boolean {",
			"\t\treturn findRoot(x) == findRoot(y)",
			"\t}",
			"\t// xとyの属する集合を併合",
			"\tfun unite(x: Int, y: Int) {",
			"\t\tvar xRoot = findRoot(x)",
			"\t\tvar yRoot = findRoot(y)",
			"\t\tif (xRoot == yRoot) return",
			"\t\tif (xRoot > yRoot) { // yの属する集合のほうが大きかったら",
			"\t\t\tval tmp = xRoot",
			"\t\t\txRoot = yRoot",
			"\t\t\tyRoot = tmp",
			"\t\t}",
			"\t\tparents[xRoot] += parents[yRoot]",
			"\t\tparents[yRoot] = xRoot // このとき子孫は変更しない (findRoot()で更新)",
			"\t\tgroups--",
			"\t}",
			"\tfun size(): Int {",
			"\t\treturn n",
			"\t}",
			"\tfun sizeOf(x: Int): Int {",
			"\t\treturn -parents[findRoot(x)]",
			"\t}",
			"\tfun groupCount(): Int {",
			"\t\treturn groups",
			"\t}",
			"}",
			""
		],
		"description": "Union find"
