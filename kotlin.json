			"\t\t\t\tif (nextValue == null) {",
			"\t\t\t\t\tthrow IllegalStateException()",
			"\t\t\t\t}",
			"\t\t\t\tval index = indexes[nextValue]",
			"\t\t\t\tremoveFromList(index!!)",
			"\t\t\t\titerator.remove()",
			"\t\t\t\tnextValue = null",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"\toverride fun remove(element: E): Boolean {",
			"\t\tval index = indexes[element]",
			"\t\tif (index == null) {",
			"\t\t\treturn false",
			"\t\t}",
			"\t\tremoveFromList(index)",
			"\t\tindexes.remove(element)",
			"\t\treturn true",
			"\t}",
			"\tprivate fun removeFromList(index: Int) {",
			"\t\tval lastElement = values.last()",
