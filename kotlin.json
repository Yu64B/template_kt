	"Segment tree": {
		"prefix": ["SegmentTree"],
		"body": [
			"class SegmentTree<T> constructor(override val size: Int, private val identity: T, private val combine: (T, T) -> T) : AbstractList<T>() {",
			"\tprivate val node: MutableList<T> // How to use Array<T>?",
			"\t// private val node = MutableList(size.shl(1)) { identity }",
			"\tprivate val nodeSize: Int",
			"\tinit {",
			"\t\tvar tmpNodeSize = 1",
			"\t\twhile (tmpNodeSize < size) tmpNodeSize = tmpNodeSize.shl(1)",
			"\t\tnodeSize = tmpNodeSize",
			"\t\tnode = MutableList(nodeSize.shl(1)) { identity }",
			"\t}",
			"\tconstructor(elements: Iterable<T>, identity: T, combine: (T, T) -> T) : this(elements.count(), identity, combine) {",
			"\t\tfor ((index, element) in elements.withIndex()) node[nodeSize + index] = element",
			"\t\t// for ((index, element) in elements.withIndex()) node[size + index] = element",
			"\t\tfor (index in nodeSize - 1 downTo 1) node[index] = combine(node[index.shl(1).or(0)], node[index.shl(1).or(1)])",
			"\t\t// for (index in size - 1 downTo 1) node[index] = combine(node[index.shl(1).or(0)], node[index.shl(1).or(1)]) ",
			"\t}",
			"\tconstructor(size: Int, init: (Int) -> T, identity: T, combine: (T, T) -> T) : this(size, identity, combine) {",
			"\t\trepeat(size) { index -> node[nodeSize + index] = init(index) }",
			"\t\t// repeat(size) { index -> node[size + index] = init(index) }",
			"\t\tfor (index in nodeSize - 1 downTo 1) node[index] = combine(node[index.shl(1).or(0)], node[index.shl(1).or(1)])",
			"\t\t// for (index in size - 1 downTo 1) node[index] = combine(node[index.shl(1).or(0)], node[index.shl(1).or(1)]) ",
			"\t}",
			"\toverride fun get(index: Int): T {",
			"\t\tcheckElementIndex(index, size)",
			"\t\treturn node[nodeSize + index]",
			"\t\t// return node[size + index]",
			"\t}",
			"\tfun set(index: Int, value: T) {",
			"\t\tcheckElementIndex(index, size)",
			"\t\tvar count = nodeSize + index",
			"\t\t// var count = size + index",
			"\t\tnode[count] = value",
			"\t\twhile (count > 1) {",
			"\t\t\tcount = count.shr(1)",
			"\t\t\tnode[count] = combine(node[count.shl(1).or(0)], node[count.shl(1).or(1)])",
			"\t\t}",
			"\t}",
			"\tfun query(fromIndex: Int, toIndex: Int): T {",
			"\t\tcheckRangeIndexes(fromIndex, toIndex, size)",
			"\t\tvar left = nodeSize + fromIndex",
			"\t\t// var left = size + fromIndex",
			"\t\tvar right = nodeSize + toIndex",
			"\t\t// var right = size + toIndex",
			"\t\tvar leftVal = identity",
			"\t\tvar rightVal = identity",
			"\t\twhile (left < right) {",
			"\t\t\tif (left.and(1) == 1) leftVal = combine(leftVal, node[left++])",
			"\t\t\tif (right.and(1) == 1) rightVal = combine(node[--right], rightVal)",
			"\t\t\tleft = left.shr(1)",
			"\t\t\tright = right.shr(1)",
			"\t\t}",
			"\t\treturn combine(leftVal, rightVal)",
			"\t}",
			"\tinternal fun checkElementIndex(index: Int, size: Int) {",
			"\t\tif (index < 0 || index >= size) {",
			"\t\t\tthrow IndexOutOfBoundsException(\"index: \\$index, size: \\$size\")",
			"\t\t}",
			"\t}",
			"\tinternal fun checkRangeIndexes(fromIndex: Int, toIndex: Int, size: Int) {",
			"\t\tif (fromIndex < 0 || toIndex > size) {",
			"\t\t\tthrow IndexOutOfBoundsException(\"fromIndex: \\$fromIndex, toIndex: \\$toIndex, size: \\$size\")",
			"\t\t}",
			"\t\tif (fromIndex > toIndex) {",
			"\t\t\tthrow IllegalArgumentException(\"fromIndex: \\$fromIndex > toIndex: \\$toIndex\")",
			"\t\t}",
			"\t}",
			"}",
			"fun <T> Iterable<T>.toSegmentTree(identity: T, combine: (T, T) -> T): SegmentTree<T> {",
			"\treturn SegmentTree(this, identity, combine)",
			"}",
			""
		],
		"description": "Segment tree"
	},
