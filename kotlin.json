	"Xor shift random": {
		"prefix": ["XorShiftRandom"],
		"body": [
			"${1:import kotlin.random.Random}",
			"class XorShiftRandom : Random {",
			"\tprivate var x = 2463534242U",
			"\tconstructor()",
			"\tconstructor(seed: Int) {",
			"\t\tx = seed.toUInt()",
			"\t\trequire(x != 0U) { \"seed must be non-zero.\" }",
			"\t}",
			"\toverride fun nextBits(bitCount: Int): Int =",
			"\t\tnextInt().takeUpperBits(bitCount)",
			"\toverride fun nextInt(): Int {",
			"\t\tx = x xor x.shl(13)",
			"\t\tx = x xor x.shr(17)",
			"\t\tx = x xor x.shl(5)",
			"\t\treturn x.toInt()",
			"\t}",
			"\toverride fun nextInt(until: Int): Int = nextInt(0, until)",
			"\toverride fun nextInt(from: Int, until: Int): Int {",
			"\t\tcheckRangeBounds(from, until)",
			"\t\treturn (nextInt().toUInt() % (until - from).toUInt()).toInt() + from",
			"\t}",
			"\toverride fun nextLong(): Long = nextInt().toLong().shl(32) + nextInt()",
			"\toverride fun nextLong(until: Long): Long = nextLong(0, until)",
			"\toverride fun nextLong(from: Long, until: Long): Long {",
			"\t\tcheckRangeBounds(from, until)",
			"\t\treturn (nextLong().toULong() % (until - from).toULong()).toLong() + from",
			"\t}",
			"\tprivate fun Int.takeUpperBits(bitCount: Int): Int =",
			"\t\tthis.ushr(32 - bitCount) and (-bitCount).shr(31)",
			"\tprivate fun checkRangeBounds(from: Int, until: Int) = require(until > from) { boundsErrorMessage(from, until) }",
			"\tprivate fun checkRangeBounds(from: Long, until: Long) = require(until > from) { boundsErrorMessage(from, until) }",
			"\tprivate fun boundsErrorMessage(from: Any, until: Any) = \"Random range is empty: [\\$from, \\$until).\"",
			"}",
			""
		],
		"description": "Xor shift random"
	},
