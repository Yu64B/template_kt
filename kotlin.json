			"\t\tif (indexes.containsKey(element)) {",
			"\t\t\treturn false",
			"\t\t}",
			"\t\tvalues.add(element)",
			"\t\tindexes[element] = values.lastIndex",
			"\t\treturn true",
			"\t}",
			"\toverride fun contains(element: E): Boolean {",
			"\t\treturn indexes.containsKey(element)",
			"\t}",
			"\toverride fun iterator(): MutableIterator<E> {",
			"\t\tval iterator = indexes.iterator()",
			"\t\tvar nextValue: E? = null",
			"\t\treturn object : MutableIterator<E> {",
			"\t\t\toverride fun hasNext(): Boolean {",
			"\t\t\t\treturn iterator.hasNext()",
			"\t\t\t}",
			"\t\t\toverride fun next(): E {",
			"\t\t\t\treturn iterator.next().key.also { nextValue = it }",
